{
  "schemaVersion": 1,
  "profile": "backend",
  "manifest": {
    "allowRootEntries": [
      ".agents",
      ".codex",
      ".cursor",
      ".pi",
      ".template-spec",
      "scripts"
    ],
    "allowRootFiles": [
      ".cursorrules",
      ".gitignore",
      ".nvmrc",
      "AGENTS.md",
      "CLAUDE.md",
      "CONTEXT.md",
      "README.md",
      "skills-lock.json",
      "yss-project.yaml",
      "yss-public-skills.json"
    ],
    "allowFiles": [
      ".template-spec/adr/README.md"
    ],
    "excludeRootEntries": [
      ".git",
      ".codegraph",
      ".codebuddy",
      ".idea",
      ".uploads",
      "node_modules",
      ".ua",
      ".qwen",
      ".template-source",
      "packages",
      ".github",
      "wiki",
      "tests"
    ],
    "excludeRootFiles": [
      "package-lock.json",
      "package.json",
      "template.manifest.json",
      "template.snapshot.json",
      ".gitmodules"
    ],
    "excludePaths": [
      ".codex/hooks.json",
      ".codex/config.toml",
      ".codex/settings.local.json",
      ".codex/skills/.DS_Store",
      ".pi/settings.json",
      ".cursor/environment.json",
      "docs/.scratch",
      "docs/reviews",
      "docs/adr",
      "scripts/instantiate-harness",
      "scripts/verify-strategic-handoff-tools-lock",
      ".work",
      "scripts/prepare-skills",
      "scripts/fixtures",
      "scripts/audit-yss-backend-skills",
      "scripts/cache-template-commit",
      "scripts/capture-maintenance-candidate",
      "scripts/export-yss-skills",
      "scripts/generate-yss-skill-boundaries",
      "scripts/inspect-maintenance-candidate",
      "scripts/run-template-verification",
      "scripts/verify-maintenance-checkpoint",
      "scripts/verify-maintenance-review-record",
      "scripts/verify-governance-release",
      "scripts/verify-retired-skill-ids",
      "scripts/verify-skill-governance",
      "scripts/verify-skill-registry",
      "scripts/verify-template",
      "scripts/verify-template-candidate",
      "scripts/verify-template-fast",
      "scripts/verify-upstream-skill-source",
      "scripts/lib/maintenance-intensity.mjs",
      "scripts/lib/maintenance-review.mjs",
      "scripts/lib/skill-governance.mjs",
      "scripts/lib/template-commit-cache.mjs",
      "scripts/lib/template-verification.mjs",
      "scripts/lib/maintenance-counterexample.mjs"
    ],
    "excludePathSuffixes": [
      "tests",
      "test"
    ],
    "renderPaths": [
      "README.md",
      "yss-project.yaml"
    ],
    "exampleDocPaths": [
      ".template-spec/discovery/IDEATION.md"
    ],
    "initExcludeRootEntries": [],
    "initExcludeRootFiles": [
      "yss-public-skills.json"
    ],
    "initExcludePaths": [],
    "ownershipPolicy": {
      "version": 1,
      "default": "managed",
      "rules": [
        {
          "pattern": ".work/**",
          "ownership": "user-owned"
        }
      ]
    }
  },
  "upgradePolicy": {
    "schemaVersion": 1,
    "assets": [
      {
        "paths": [
          "CONTEXT.md",
          "yss-project.yaml",
          ".template-spec/agents/issue-tracker.md",
          "README.md"
        ],
        "kind": "preserve"
      },
      {
        "paths": [
          "AGENTS.md",
          ".gitignore",
          "DESIGN.md"
        ],
        "kind": "customizable"
      },
      {
        "paths": [
          "skills-lock.json",
          ".template-spec/process/harness-profile.yaml",
          ".agents/skills/.public-skills.json",
          ".agents/skills/.skills-manifest.json"
        ],
        "kind": "generated",
        "generator": "native-bundle"
      }
    ],
    "rules": []
  }
}
